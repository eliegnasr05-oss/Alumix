<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alumix | Forgot Password</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body, html { height: 100%; font-family: 'Inter', sans-serif; }
        body {
            background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        body::before {
            content: '';
            position: absolute;
            top: -50%; right: -50%;
            width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(28, 146, 210, 0.1) 0%, transparent 70%);
            animation: rotate 30s linear infinite;
        }
        @keyframes rotate { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .container {
            width: 90%; max-width: 480px;
            background: rgba(255, 255, 255, 0.98);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden; position: relative; z-index: 1;
        }
        .logo {
            font-size: 42px; font-weight: 700; text-align: center; margin-bottom: 40px;
            background: linear-gradient(135deg, #1c92d2 0%, #0b6fa4 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            letter-spacing: 3px;
        }
        .forgot-side { padding: 50px 40px; }
        .forgot-header { margin-bottom: 40px; text-align: center; }
        .forgot-header h2 { color: #1a1a1a; font-weight: 700; font-size: 32px; margin-bottom: 12px; }
        .forgot-header p { color: #666; font-size: 15px; line-height: 1.6; }
        .error {
            background-color: #fee; color: #c33; padding: 12px 16px; border-radius: 8px;
            margin-bottom: 20px; font-size: 14px; border-left: 4px solid #c33; animation: shake 0.4s;
        }
        .success {
            background-color: #e8f5e9; color: #2e7d32; padding: 12px 16px; border-radius: 8px;
            margin-bottom: 20px; font-size: 14px; border-left: 4px solid #2e7d32;
        }
        @keyframes shake { 0%,100%{transform:translateX(0);} 25%{transform:translateX(-10px);} 75%{transform:translateX(10px);} }
        .icon-container { text-align: center; margin-bottom: 30px; }
        .icon {
            width: 80px; height: 80px;
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 36px;
        }
        .form-group { margin-bottom: 24px; }
        .form-group label { display: block; margin-bottom: 8px; color: #333; font-weight: 500; font-size: 14px; }
        .form-group input {
            width: 100%; padding: 14px 16px; border-radius: 10px; border: 2px solid #e0e0e0;
            font-size: 15px; transition: all 0.3s ease; background: #fafafa;
        }
        .form-group input:focus { border-color: #1c92d2; outline: none; background: white; box-shadow: 0 0 0 3px rgba(28,146,210,0.1); }
        .btn-send {
            width: 100%; padding: 14px;
            background: linear-gradient(135deg, #1c92d2 0%, #0b6fa4 100%);
            color: white; border: none; font-size: 16px; font-weight: 600; border-radius: 10px;
            cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(28,146,210,0.3);
        }
        .btn-send:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(28,146,210,0.4); }
        .btn-send:active { transform: translateY(0); }
        .back-to-login { text-align: center; margin-top: 20px; }
        .back-to-login a { color: #1c92d2; text-decoration: none; font-size: 14px; transition: color 0.3s ease; display: inline-flex; align-items: center; gap: 6px; }
        .back-to-login a:hover { color: #0b6fa4; text-decoration: underline; }
        .footer { text-align: center; margin-top: 40px; padding-top: 30px; border-top: 1px solid #e0e0e0; font-size: 13px; color: #999; }
        @media (max-width:768px){.container{width:95%;margin:20px;}.forgot-side{padding:40px 30px;}.logo{font-size:36px;}.forgot-header h2{font-size:26px;}.forgot-header p{font-size:14px;}.icon{width:70px;height:70px;font-size:32px;}.form-group input{padding:12px 14px;}.btn-send{padding:12px;}}
        @media (max-width:480px){.forgot-side{padding:30px 20px;}.logo{font-size:32px;margin-bottom:30px;}.forgot-header h2{font-size:24px;}.icon{width:60px;height:60px;font-size:28px;}}
    </style>
</head>
<body>
    <div class="container">
        <div class="forgot-side">
            <div class="logo">ALUMIX</div>
            
            <div class="icon-container">
                <div class="icon">🔒</div>
            </div>

            <div class="forgot-header">
                <h2>Forgot Password?</h2>
                <p>No worries! Enter your email address and we'll send you a code to reset your password.</p>
            </div>

            <!-- Error / Success messages -->
            <% if (typeof error !== 'undefined') { %>
                <div class="error"><%= error %></div>
            <% } %>

            <% if (typeof success !== 'undefined') { %>
                <div class="success"><%= success %></div>
            <% } %>

            <form method="POST" action="/users/forgot-password">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" placeholder="you@company.com" required value="<%= typeof email !== 'undefined' ? email : '' %>">
                </div>

                <button type="submit" class="btn-send">Send OTP</button>

                <div class="back-to-login">
                    <a href="/adminAlumix">
                        <span>←</span>
                        <span>Back to Login</span>
                    </a>
                </div>
            </form>

            <div class="footer">
                &copy; <span id="year"></span> Alumix. All rights reserved.
            </div>
        </div>
    </div>

    <script>
        document.getElementById('year').textContent = new Date().getFullYear();
    </script>
</body>
</html>
