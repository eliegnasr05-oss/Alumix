<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Alumix | Admin Login</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  >

  <style>
    :root {
      --background: #06171c;
      --background-light: #0a252c;
      --card: rgba(9, 35, 42, 0.94);
      --cyan: #4dd0e1;
      --cyan-dark: #26c6da;
      --white: #ffffff;
      --text: #d3e2e6;
      --muted: #91a7ad;
      --border: rgba(77, 208, 225, 0.3);
      --input-background: rgba(4, 21, 26, 0.75);
      --error: #ff6b6b;
      --success: #36d98b;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      min-height: 100%;
    }

    body {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
      padding: 35px 20px;
      color: var(--text);
      background:
        radial-gradient(
          circle at 20% 20%,
          rgba(77, 208, 225, 0.14),
          transparent 35%
        ),
        radial-gradient(
          circle at 80% 80%,
          rgba(38, 198, 218, 0.1),
          transparent 35%
        ),
        linear-gradient(
          135deg,
          var(--background),
          var(--background-light)
        );
      font-family: "Inter", sans-serif;
    }

    /* Decorative background grid */

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: 0.15;
      background-image:
        linear-gradient(
          rgba(77, 208, 225, 0.12) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(77, 208, 225, 0.12) 1px,
          transparent 1px
        );
      background-size: 55px 55px;
      mask-image:
        radial-gradient(circle at center, black, transparent 80%);
    }

    /* Decorative glow */

    body::after {
      content: "";
      position: fixed;
      top: -250px;
      right: -250px;
      z-index: 0;
      width: 600px;
      height: 600px;
      pointer-events: none;
      border-radius: 50%;
      background: rgba(77, 208, 225, 0.08);
      filter: blur(70px);
      animation: glowMovement 8s ease-in-out infinite alternate;
    }

    @keyframes glowMovement {
      from {
        transform: translate(0, 0) scale(1);
      }

      to {
        transform: translate(-80px, 80px) scale(1.15);
      }
    }

    /* Login card */

    .login-card {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 470px;
      padding: 42px;
      overflow: hidden;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.5),
        0 0 35px rgba(77, 208, 225, 0.08);
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
    }

    .login-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background:
        linear-gradient(
          90deg,
          transparent,
          var(--cyan),
          transparent
        );
    }

    /* Logo */

    .login-logo {
      width: 100%;
      display: flex;
      justify-content: center;
      margin-bottom: 28px;
    }

    .login-logo img {
      display: block;
      width: 230px;
      height: 105px;
      max-width: 100%;
      object-fit: contain;
      transform: scale(1.7);
      transition: none;
    }

    .login-logo img:hover {
      transform: scale(1.7);
    }

    /* Heading */

    .login-heading {
      margin-bottom: 28px;
      text-align: center;
    }

    .login-heading h1 {
      margin-bottom: 8px;
      color: var(--white);
      font-family: "Space Grotesk", sans-serif;
      font-size: 29px;
      font-weight: 700;
      line-height: 1.2;
    }

    .login-heading h1 span {
      color: var(--cyan);
    }

    .login-heading p {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }

    /* Alerts */

    .alert {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 13px 15px;
      margin-bottom: 20px;
      border-radius: 8px;
      font-size: 13px;
      line-height: 1.5;
    }

    .alert i {
      margin-top: 2px;
      flex-shrink: 0;
    }

    .alert-error {
      color: #ffd4d4;
      background: rgba(255, 107, 107, 0.12);
      border: 1px solid rgba(255, 107, 107, 0.35);
      border-left: 4px solid var(--error);
    }

    .alert-success {
      color: #caffdf;
      background: rgba(54, 217, 139, 0.12);
      border: 1px solid rgba(54, 217, 139, 0.35);
      border-left: 4px solid var(--success);
    }

    /* Form */

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: block;
      margin-bottom: 8px;
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
    }

    .input-wrapper {
      position: relative;
    }

    .input-icon {
      position: absolute;
      top: 50%;
      left: 16px;
      z-index: 1;
      color: var(--cyan);
      font-size: 14px;
      pointer-events: none;
      transform: translateY(-50%);
    }

    .form-input {
      width: 100%;
      height: 52px;
      padding: 0 48px 0 45px;
      color: var(--white);
      background: var(--input-background);
      border: 1px solid rgba(176, 190, 197, 0.22);
      border-radius: 10px;
      font-family: inherit;
      font-size: 14px;
      transition:
        border-color 0.25s ease,
        box-shadow 0.25s ease,
        background-color 0.25s ease;
    }

    .form-input::placeholder {
      color: #688087;
    }

    .form-input:hover {
      border-color: rgba(77, 208, 225, 0.45);
    }

    .form-input:focus {
      outline: none;
      background: rgba(4, 21, 26, 0.95);
      border-color: var(--cyan);
      box-shadow: 0 0 0 4px rgba(77, 208, 225, 0.12);
    }

    /* Password toggle */

    .password-toggle {
      position: absolute;
      top: 50%;
      right: 13px;
      width: 34px;
      height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      background: transparent;
      border: 0;
      border-radius: 7px;
      cursor: pointer;
      transform: translateY(-50%);
      transition:
        color 0.25s ease,
        background-color 0.25s ease;
    }

    .password-toggle:hover {
      color: var(--cyan);
      background: rgba(77, 208, 225, 0.1);
    }

    .password-toggle:focus-visible {
      outline: 2px solid var(--cyan);
      outline-offset: 2px;
    }

    /* Submit button */

    .login-button {
      width: 100%;
      height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 5px;
      color: #06171c;
      background:
        linear-gradient(
          135deg,
          var(--cyan),
          var(--cyan-dark)
        );
      border: 0;
      border-radius: 10px;
      font-family: inherit;
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.7px;
      cursor: pointer;
      box-shadow: 0 10px 25px rgba(77, 208, 225, 0.2);
      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        background-color 0.25s ease;
    }

    .login-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 32px rgba(77, 208, 225, 0.35);
    }

    .login-button:active {
      transform: translateY(0);
    }

    .login-button:focus-visible {
      outline: 3px solid rgba(77, 208, 225, 0.4);
      outline-offset: 3px;
    }

    /* Account links */

    .login-links {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-top: 20px;
      font-size: 13px;
    }

    .login-links a {
      color: var(--cyan);
      font-weight: 500;
      text-decoration: none;
      transition: color 0.25s ease;
    }

    .login-links a:hover {
      color: var(--white);
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    /* Footer */

    .login-footer {
      padding-top: 22px;
      margin-top: 30px;
      color: #6f858b;
      border-top: 1px solid rgba(77, 208, 225, 0.14);
      font-size: 12px;
      text-align: center;
    }

    .login-footer strong {
      color: var(--cyan);
    }

    /* Responsive */

    @media (max-width: 520px) {
      body {
        align-items: flex-start;
        padding: 20px 14px;
      }

      .login-card {
        max-width: 100%;
        padding: 30px 22px;
        border-radius: 17px;
      }

      .login-logo {
        margin-bottom: 20px;
      }

      .login-logo img,
      .login-logo img:hover {
        width: 190px;
        height: 85px;
        transform: scale(1.55);
      }

      .login-heading {
        margin-bottom: 24px;
      }

      .login-heading h1 {
        font-size: 25px;
      }

      .login-heading p {
        font-size: 13px;
      }

      .form-input,
      .login-button {
        height: 49px;
      }

      .login-links {
        flex-direction: column;
        gap: 12px;
      }
    }

    @media (max-width: 360px) {
      .login-card {
        padding: 26px 17px;
      }

      .login-logo img,
      .login-logo img:hover {
        width: 170px;
        transform: scale(1.45);
      }
    }
  </style>
</head>

<body>

  <main class="login-card">

    <!-- Logo -->

    <div class="login-logo">
      <img src="/images/logo.png" alt="Alumix Logo">
    </div>

    <!-- Heading -->

    <div class="login-heading">
      <h1>Admin <span>Login</span></h1>

      <p>
        Sign in to access the Alumix administration panel.
      </p>
    </div>

    <!-- Success message -->

    <% if (typeof success !== "undefined" && success) { %>
      <div class="alert alert-success" role="alert">
        <i class="fas fa-circle-check" aria-hidden="true"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <!-- Error message -->

    <% if (typeof error !== "undefined" && error) { %>
      <div class="alert alert-error" role="alert">
        <i class="fas fa-circle-exclamation" aria-hidden="true"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Login form -->

    <form action="/users/login" method="POST">

      <div class="form-group">
        <label class="form-label" for="email">
          Email Address
        </label>

        <div class="input-wrapper">
          <i
            class="fas fa-envelope input-icon"
            aria-hidden="true"
          ></i>

          <input
            class="form-input"
            type="email"
            id="email"
            name="email"
            placeholder="you@company.com"
            autocomplete="email"
            required
          >
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">
          Password
        </label>

        <div class="input-wrapper">
          <i
            class="fas fa-lock input-icon"
            aria-hidden="true"
          ></i>

          <input
            class="form-input"
            type="password"
            id="password"
            name="pass"
            placeholder="Enter your password"
            autocomplete="current-password"
            required
          >

          <button
            class="password-toggle"
            id="passwordToggle"
            type="button"
            aria-label="Show password"
            aria-pressed="false"
          >
            <i
              class="fas fa-eye"
              id="passwordIcon"
              aria-hidden="true"
            ></i>
          </button>
        </div>
      </div>

      <button class="login-button" type="submit">
        <span>Sign In</span>
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
      </button>
    </form>

    <!-- Links -->

    <div class="login-links">
      <a href="/users/forgot-password">
        Forgot Password?
      </a>

      <a href="/users/create-account">
        Create Account
      </a>
    </div>

    <!-- Copyright -->

    <div class="login-footer">
      &copy;
      <span id="currentYear"></span>
      <strong>Alumix</strong>. All Rights Reserved.
    </div>
  </main>

  <script>
    const currentYear = document.getElementById("currentYear");
    const passwordInput = document.getElementById("password");
    const passwordToggle = document.getElementById("passwordToggle");
    const passwordIcon = document.getElementById("passwordIcon");

    if (currentYear) {
      currentYear.textContent = new Date().getFullYear();
    }

    if (passwordInput && passwordToggle && passwordIcon) {
      passwordToggle.addEventListener("click", function () {
        const passwordIsHidden = passwordInput.type === "password";

        passwordInput.type = passwordIsHidden ? "text" : "password";

        passwordIcon.classList.toggle("fa-eye", !passwordIsHidden);
        passwordIcon.classList.toggle("fa-eye-slash", passwordIsHidden);

        passwordToggle.setAttribute(
          "aria-label",
          passwordIsHidden ? "Hide password" : "Show password"
        );

        passwordToggle.setAttribute(
          "aria-pressed",
          String(passwordIsHidden)
        );
      });
    }
  </script>

</body>
</html>